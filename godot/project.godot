; GONG feel test - Godot 4.7 project file

config_version=5

[application]

config/name="GONG"
config/description="GONG, the Godot port of the web build."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=390
window/size/viewport_height=740
window/handheld/orientation=1

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.11, 0.157, 0.18, 1)
anti_aliasing/quality/msaa_3d=2
